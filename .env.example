# Copier ce fichier en .env avant `docker compose up`.

# En laissant ACCEPT_EULA=Y, tu acceptes le contrat de licence de Microsoft SQL Server :
# https://go.microsoft.com/fwlink/?linkid=857698
ACCEPT_EULA=Y

# Mot de passe du compte "sa" du SQL Server du conteneur. Valeur de démonstration : le port n'est
# ouvert que sur cette machine, mais change-la si tu exposes autre chose. Exigences de SQL Server :
# au moins 8 caractères avec majuscules, minuscules, chiffres et symboles.
MSSQL_SA_PASSWORD=Climate!Demo2026

# Ports sur ta machine (facultatif)
# WEB_PORT=8080
# DB_PORT=14333

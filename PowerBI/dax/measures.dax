-- Mesures suggérées pour le modèle Power BI.
-- À coller une par une dans "Nouvelle mesure" sur la table concernée.

-- === Température ===
-- ATTENTION : la moyenne simple (vw_Temperature) décrit les stations actives une année donnée.
-- Le réseau de stations change, donc elle n'est PAS comparable d'une année à l'autre :
-- ne pas l'utiliser pour une variation ou une tendance. Utiliser les anomalies (vw_TemperatureAnomalie).

Temperature Observee = AVERAGE(vw_Temperature[TemperatureMoyenne])

Anomalie Moyenne = AVERAGE(vw_TemperatureAnomalie[AnomalieStationsLongues])

Anomalie Annee Precedente =
CALCULATE(
    [Anomalie Moyenne],
    FILTER(ALL(Annee), Annee[ValeurAnnee] = MAX(Annee[ValeurAnnee]) - 1)
)

Variation Anomalie = [Anomalie Moyenne] - [Anomalie Annee Precedente]

-- Tendance 2000-2025 (°C par décennie) et son intervalle de confiance à 95 %.
-- Filtrer sur une province (ou CA = Canada) avec un segment sur vw_TemperatureTendance[CodeProvince].
Tendance Par Decennie =
CALCULATE(
    MAX(vw_TemperatureTendance[PenteParDecennie]),
    vw_TemperatureTendance[Methode] = "anomalie_stations_longues"
)

Tendance IC Bas =
CALCULATE(
    MAX(vw_TemperatureTendance[IC95_Bas]),
    vw_TemperatureTendance[Methode] = "anomalie_stations_longues"
)

Tendance IC Haut =
CALCULATE(
    MAX(vw_TemperatureTendance[IC95_Haut]),
    vw_TemperatureTendance[Methode] = "anomalie_stations_longues"
)

Tendance Significative =
IF([Tendance IC Bas] > 0 || [Tendance IC Haut] < 0, "Significative", "Non concluante")


-- === Précipitations ===
-- ATTENTION : le cumul simple (vw_Precipitation) additionne les stations actives une année donnée.
-- Le réseau change et la part de relevés incomplets a bondi en 2008 : il n'est PAS comparable d'une
-- année à l'autre. Pour une tendance, utiliser les anomalies en % de la normale (vw_PrecipitationAnomalie).

Precipitation Observee = SUM(vw_Precipitation[PrecipitationAnnuelle])

Precipitation Moyenne Provinciale = AVERAGE(vw_Precipitation[PrecipitationAnnuelle])

Anomalie Precipitation Pct = AVERAGE(vw_PrecipitationAnomalie[AnomalieStationsLongues])

-- Tendance en % de la normale par décennie (vide pour le Yukon : aucune station de longue durée).
Tendance Precipitation Pct Par Decennie =
CALCULATE(
    MAX(vw_PrecipitationTendance[PenteParDecennie]),
    vw_PrecipitationTendance[Methode] = "anomalie_stations_longues"
)

Tendance Precipitation IC Bas =
CALCULATE(
    MAX(vw_PrecipitationTendance[IC95_Bas]),
    vw_PrecipitationTendance[Methode] = "anomalie_stations_longues"
)

Tendance Precipitation IC Haut =
CALCULATE(
    MAX(vw_PrecipitationTendance[IC95_Haut]),
    vw_PrecipitationTendance[Methode] = "anomalie_stations_longues"
)


-- === Pollution (table vw_Pollution) ===
-- IMPORTANT : les dernières années contiennent des NULL (données ECCC pas encore publiées).
-- AVERAGE/SUM ignorent les NULL par défaut, donc pas besoin de filtrer à la main.

Emissions Moyennes = AVERAGE(vw_Pollution[EmissionGES_MtCO2e])

Emissions Totales = SUM(vw_Pollution[EmissionGES_MtCO2e])

Derniere Annee Publiee =
CALCULATE(
    MAX(vw_Pollution[Annee]),
    NOT ISBLANK(vw_Pollution[EmissionGES_MtCO2e])
)

Provinces Sans Donnees =
CALCULATE(
    DISTINCTCOUNT(vw_Pollution[CodeProvince]),
    ISBLANK(vw_Pollution[EmissionGES_MtCO2e])
)
